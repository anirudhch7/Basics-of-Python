        "\n",
        "### 19.a) Newton-Raphson Method"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "36bbaf11",
        "outputId": "dd225aff-82bd-473a-8307-5d743d076da6"
      },
      "source": [
        "def f(x): return x**2 - 2\n",
        "def df(x): return 2*x\n",
        "x0 = 1.5\n",
        "for _ in range(10): x0 = x0 - f(x0)/df(x0)\n",
        "print(f\"Root: {x0}\")"
      ],
      "execution_count": 20,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Root: 1.4142135623730951\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "3799ffa7"
      },
      "source": [
        "### 19.b) Bisection Method"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "df33514f",
        "outputId": "ff587fb1-68f4-49db-c1f8-44d1ac373560"
      },
      "source": [
        "def bisection(a, b):\n",
        "    if f(a)*f(b) >= 0: return None\n",
        "    for _ in range(50):\n",
        "        mid = (a+b)/2\n",
        "        if f(mid) == 0: break\n",
        "        if f(a)*f(mid) < 0: b = mid\n",
        "        else: a = mid\n",
        "    return (a+b)/2\n",
        "print(f\"Root: {bisection(1, 2)}\")"
      ],
      "execution_count": 21,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Root: 1.4142135623730954\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "b7def07e"
      },
      "source": [
        "### 20.a) Integration Rules"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "4ab6d914",
        "outputId": "8fe7c53c-26ed-4722-cf0a-7655ab5a4483"
      },
      "source": [
        "def integrate(f, a, b, n):\n",
        "    h = (b-a)/n\n",
        "    x = [a + i*h for i in range(n+1)]\n",
        "    y = [f(val) for val in x]\n",
        "    trap = (h/2) * (y[0] + 2*sum(y[1:-1]) + y[-1])\n",
        "    s13 = (h/3) * (y[0] + 4*sum(y[1:-1:2]) + 2*sum(y[2:-2:2]) + y[-1])\n",
        "    return trap, s13\n",
        "print(\"Trapezoidal, Simpson 1/3:\", integrate(lambda x: x**2, 0, 1, 10))"
      ],
      "execution_count": 22,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Trapezoidal, Simpson 1/3: (0.3350000000000001, 0.3333333333333333)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "397f8360"
      },
      "source": [
        "### 20.b) Interpolation"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "03183f7d",
        "outputId": "5bd361b2-1f8c-4c9a-d9e7-5e27658e3ad9"
      },
      "source": [
        "def lagrange(x_pts, y_pts, x):\n",
        "    total = 0\n",
        "    for i in range(len(x_pts)):\n",
        "        p = 1\n",
        "        for j in range(len(x_pts)):\n",
        "            if i != j: p *= (x - x_pts[j])/(x_pts[i] - x_pts[j])\n",
        "        total += y_pts[i] * p\n",
        "    return total\n",
        "print(f\"Lagrange at 2.5: {lagrange([1, 2, 3], [1, 4, 9], 2.5)}\")"
      ],
      "execution_count": 25,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Lagrange at 2.5: 6.25\n"
          ]
        }
      ]
    }

      "cell_type": "code",
      "metadata": {
        "id": "b8ec6ba5"
      },
      "source": [
        "def fib_gen(n):\n",
        "    a, b = 0, 1\n",
        "    for _ in range(n):\n",
        "        yield a; a, b = b, a + b\n",
        "\n",
        "print(list(fib_gen(10)))"

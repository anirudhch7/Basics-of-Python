    {
      "cell_type": "code",
      "metadata": {
        "id": "0285a855"
      },
      "source": [
        "class Stack:\n",
        "    def __init__(self): self.items = []\n",
        "    def push(self, item): self.items.append(item)\n",
        "    def pop(self): return self.items.pop() if not self.is_empty() else None\n",
        "    def is_empty(self): return len(self.items) == 0\n",
        "\n",
        "s = Stack()\n",
        "s.push(1); s.push(2)\n",
        "print(f\"Popped from stack: {s.pop()}\")"
      ],

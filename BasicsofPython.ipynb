        "outputId": "102f2c23-ff0d-44e6-82d9-fe98a94161f7"
      },
      "source": [
        "rows = int(input(\"Enter the number of rows for Floyd's Triangle: \"))\n",
        "num = 1\n",
        "print(\"Floyd's Triangle:\")\n",
        "for i in range(1, rows + 1):\n",
        "    for j in range(1, i + 1):\n",
        "        print(num, end=\" \")\n",
        "        num += 1\n",
        "    print()"
      ],
      "execution_count": 3,

      },
      "source": [
        "### 3.d) Square Root with Break and Continue"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "86400452"
      },
      "source": [
        "import math\n",
        "\n",
        "while True:\n",
        "    val = input(\"Enter a number to find square root (or 'q' to quit): \")\n",
        "\n",
        "    if val.lower() == 'q':\n",
        "        break # Exit loop\n",
        "\n",
        "    num = float(val)\n",
        "\n",
        "    if num < 0:\n",
        "        print(\"Cannot calculate square root of a negative number. Try again.\")\n",
        "        continue # Skip to next iteration\n",
        "\n",
        "    print(f\"The square root of {num} is {math.sqrt(num)}\")"
      ],
      "execution_count": null,
      "outputs": []
    },

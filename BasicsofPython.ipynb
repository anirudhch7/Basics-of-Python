      "source": [
        "### 3.a) Simple Interest and Compound Interest"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "99b33466"
      },
      "source": [
        "p = float(input(\"Enter principal amount: \"))\n",
        "t = float(input(\"Enter time (years): \"))\n",
        "r = float(input(\"Enter rate of interest: \"))\n",
        "\n",
        "si = (p * t * r) / 100\n",
        "ci = p * (pow((1 + r / 100), t)) - p\n",
        "\n",
        "print(f\"Simple Interest: {si}\")\n",
        "print(f\"Compound Interest: {ci}\")"
      ],
      "execution_count": null,
      "outputs": []

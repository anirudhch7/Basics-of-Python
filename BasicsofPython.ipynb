      },
      "source": [
        "### 1.a) Arithmetic operations on Integers"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "789f9314",
        "outputId": "d9ba78e7-0896-41fe-f9ce-a6b242838a41"
      },
      "source": [
        "try:\n",
        "    num1 = int(input(\"Enter first integer: \"))\n",
        "    num2 = int(input(\"Enter second integer: \"))\n",
        "\n",
        "    print(f\"\\nResults for {num1} and {num2}:\")\n",
        "    print(f\"{num1} + {num2} = {num1 + num2}\")\n",
        "    print(f\"{num1} - {num2} = {num1 - num2}\")\n",
        "    print(f\"{num1} * {num2} = {num1 * num2}\")\n",
        "    if num2 != 0:\n",
        "        print(f\"{num1} / {num2} = {num1 / num2}\")\n",
        "        print(f\"{num1} // {num2} = {num1 // num2}\")\n",
        "        print(f\"{num1} % {num2} = {num1 % num2}\")\n",
        "    else:\n",
        "        print(\"Division by zero is not allowed.\")\n",
        "    print(f\"{num1} ** {num2} = {num1 ** num2}\")\n",
        "except ValueError:\n",
        "    print(\"Invalid input! Please enter integers.\")"
      ],
      "execution_count": 1,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Enter first integer: 2\n",
            "Enter second integer: 3\n",
            "\n",
            "Results for 2 and 3:\n",
            "2 + 3 = 5\n",
            "2 - 3 = -1\n",
            "2 * 3 = 6\n",
            "2 / 3 = 0.6666666666666666\n",
            "2 // 3 = 0\n",
            "2 % 3 = 2\n",
            "2 ** 3 = 8\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "094f19bd"
      },
      "source": [
        "### 1.b) Arithmetic operations on Floating Point Numbers"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "cfbd81ac",
        "outputId": "f2454b1f-330c-4c8c-dcd7-2e78f326f4e2"
      },
      "source": [
        "try:\n",
        "    f_num1 = float(input(\"Enter first floating point number: \"))\n",
        "    f_num2 = float(input(\"Enter second floating point number: \"))\n",
        "\n",
        "    print(f\"\\nResults for {f_num1} and {f_num2}:\")\n",
        "    print(f\"{f_num1} + {f_num2} = {f_num1 + f_num2}\")\n",
        "    print(f\"{f_num1} - {f_num2} = {f_num1 - f_num2}\")\n",
        "    print(f\"{f_num1} * {f_num2} = {f_num1 * f_num2}\")\n",
        "    if f_num2 != 0:\n",
        "        print(f\"{f_num1} / {f_num2} = {f_num1 / f_num2}\")\n",
        "        print(f\"{f_num1} // {f_num2} = {f_num1 // f_num2}\")\n",
        "        print(f\"{f_num1} % {f_num2} = {f_num1 % f_num2}\")\n",
        "    else:\n",
        "        print(\"Division by zero is not allowed.\")\n",
        "    print(f\"{f_num1} ** {f_num2} = {f_num1 ** f_num2}\")\n",
        "except ValueError:\n",
        "    print(\"Invalid input! Please enter numbers.\")"
      ],
      "execution_count": 2,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Enter first floating point number: 5.3\n",
            "Enter second floating point number: 45.2\n",
            "\n",
            "Results for 5.3 and 45.2:\n",
            "5.3 + 45.2 = 50.5\n",
            "5.3 - 45.2 = -39.900000000000006\n",
            "5.3 * 45.2 = 239.56\n",
            "5.3 / 45.2 = 0.11725663716814158\n",
            "5.3 // 45.2 = 0.0\n",
            "5.3 % 45.2 = 5.3\n",
            "5.3 ** 45.2 = 5.460963904250332e+32\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "736f4ed3"
      },
      "source": [
        "### 2.a) Implicit Type Conversion\n",
        "Python automatically converts one data type to another without user involvement."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "9a27002e"
      },
      "source": [
        "num_int = 123\n",
        "num_flo = 1.23\n",
        "\n",
        "num_new = num_int + num_flo\n",
        "\n",
        "print(\"datatype of num_int:\", type(num_int))\n",
        "print(\"datatype of num_flo:\", type(num_flo))\n",
        "print(\"Value of num_new:\", num_new)\n",
        "print(\"datatype of num_new:\", type(num_new))"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "8969b4d7"
      },
      "source": [
        "### 2.b) Explicit Type Conversion\n",
        "Also known as Type Casting, where the user converts the data type using built-in functions."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "c65c8070"
      },
      "source": [
        "num_str = \"456\"\n",
        "num_int = 100\n",
        "\n",
        "print(\"Data type of num_str before casting:\", type(num_str))\n",
        "\n",
        "# explicit type conversion\n",
        "num_str = int(num_str)\n",
        "\n",
        "print(\"Data type of num_str after casting:\", type(num_str))\n",
        "num_sum = num_int + num_str\n",
        "\n",
        "print(\"Sum of num_int and num_str:\", num_sum)\n",
        "print(\"Data type of the sum:\", type(num_sum))"
      ],
      "execution_count": null,
      "outputs": []
    },
    {

      "source": [
        "### 17.a) Iterator for Squares"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "6529ebd6"
      },
      "source": [
        "class Squares:\n",
        "    def __init__(self, limit):\n",
        "        self.limit = limit\n",
        "        self.n = 1\n",
        "    def __iter__(self): return self\n",
        "    def __next__(self):\n",
        "        if self.n <= self.limit:\n",
        "            res = self.n ** 2; self.n += 1; return res\n",
        "        raise StopIteration\n",
        "\n",
        "for val in Squares(5): print(val)"
      ],
      "execution_count": null,
      "outputs": []
    },

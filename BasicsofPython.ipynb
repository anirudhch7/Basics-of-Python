        "### 8.a) Sphere Surface Area and Volume"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "b932bdc0"
      },
      "source": [
        "import math\n",
        "def sphere_metrics(r):\n",
        "    area = 4 * math.pi * r**2\n",
        "    volume = (4/3) * math.pi * r**3\n",
        "    return area, volume\n",
        "radius = float(input(\"Enter radius: \"))\n",
        "a, v = sphere_metrics(radius)\n",
        "print(f\"Area: {a:.2f}, Volume: {v:.2f}\")"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "e78577dc"
      },
      "source": [
        "### 8.b) Fibonacci (Recursion vs Iteration)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "843af2f3"
      },
      "source": [
        "def fib_rec(n):\n",
        "    return n if n <= 1 else fib_rec(n-1) + fib_rec(n-2)\n",
        "\n",
        "def fib_iter(n):\n",
        "    a, b = 0, 1\n",
        "    for _ in range(n): yield a; a, b = b, a + b\n",
        "\n",
        "terms = 10\n",
        "print(\"Recursive:\", [fib_rec(i) for i in range(terms)])\n",
        "print(\"Iterative:\", list(fib_iter(terms)))"
      ],
      "execution_count": null,
      "outputs": []
    },
